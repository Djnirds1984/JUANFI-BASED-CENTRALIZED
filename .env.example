# MikroTik Controller Configuration

# Server Configuration
PORT=3000
HOST=0.0.0.0

# JWT Secret (CHANGE THIS IN PRODUCTION)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Database
DB_PATH=./data/mikrotik-controller.db

# Logging
LOG_LEVEL=info

# Default Admin Credentials (CHANGE ON FIRST LOGIN)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# LAN IP of this controller as seen by hotspot clients. Used to auto-allow the
# controller in each router's Walled Garden and to build the stub portal
# redirect URL (panel-hosted captive portal). If unset, the first non-virtual
# LAN IPv4 address is auto-detected.
# CONTROLLER_LAN_IP=192.168.88.2

# Public base URL the captive-portal stubs redirect to. Set this when the panel
# is served through nginx / a domain so the portal does NOT open on the raw
# node port (:3000). Examples:
#   PANEL_PUBLIC_URL=http://10.0.0.252          (nginx, HTTP)
#   PANEL_PUBLIC_URL=https://portal.example.com (nginx + TLS)
# Leave unset to keep pointing straight at the node process (http://<lan-ip>:PORT).
# PANEL_PUBLIC_URL=http://10.0.0.252

# RADIUS Server Configuration
# UDP ports for the built-in RADIUS server (used when a router is in RADIUS mode)
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813

# Customer Wallet (money accounts on the portal)
# Secret for CUSTOMER session tokens. Keep it different from JWT_SECRET so a
# wallet token can never be replayed against the admin API. If unset it is
# derived as "$JWT_SECRET:client", which is already isolated from the panel.
# CLIENT_JWT_SECRET=

# How long a customer stays signed in on their device (default 720h = 30 days)
# CLIENT_TOKEN_TTL=720h

# Where password-restore codes are sent. With NO SMTP settings below, codes are
# posted into the device's own portal chat thread (and shown to staff on the
# Customers / Wallet page), which needs no internet and no credentials.
# To switch to real email: fill these in and run `npm install nodemailer`, then
# restart the controller. Nothing else changes.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=portal@example.com
# SMTP_PASS=app-password-here
# MAIL_FROM="JuanFi Portal <portal@example.com>"
