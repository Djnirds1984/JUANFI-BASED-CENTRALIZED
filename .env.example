# MikroTik Controller Configuration

# Server Configuration
PORT=3000
HOST=0.0.0.0

# JWT Secret (CHANGE THIS IN PRODUCTION)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Database
DB_PATH=./data/mikrotik-controller.db

# Logging
LOG_LEVEL=info

# Default Admin Credentials (CHANGE ON FIRST LOGIN)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# LAN IP of this controller as seen by hotspot clients. Used to auto-allow the
# controller in each router's Walled Garden and to build the stub portal
# redirect URL (panel-hosted captive portal). If unset, the first non-virtual
# LAN IPv4 address is auto-detected.
# CONTROLLER_LAN_IP=192.168.88.2

# Public base URL the captive-portal stubs redirect to. Set this when the panel
# is served through nginx / a domain so the portal does NOT open on the raw
# node port (:3000). Examples:
#   PANEL_PUBLIC_URL=http://10.0.0.252          (nginx, HTTP)
#   PANEL_PUBLIC_URL=https://portal.example.com (nginx + TLS)
# Leave unset to keep pointing straight at the node process (http://<lan-ip>:PORT).
# PANEL_PUBLIC_URL=http://10.0.0.252

# RADIUS Server Configuration
# UDP ports for the built-in RADIUS server (used when a router is in RADIUS mode)
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
