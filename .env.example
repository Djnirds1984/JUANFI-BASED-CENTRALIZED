# MikroTik Controller Configuration

# Server Configuration
PORT=3000
HOST=0.0.0.0

# JWT Secret (CHANGE THIS IN PRODUCTION)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Database
DB_PATH=./data/mikrotik-controller.db

# Logging
LOG_LEVEL=info

# Default Admin Credentials (CHANGE ON FIRST LOGIN)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# LAN IP of this controller as seen by hotspot clients (must match the IP in
# hotspot/assets/js/config.js -> controllerApiUrl). Required so the server can
# auto-allow the controller in each router's Walled Garden — without this,
# the portal CANNOT reach /api/session/* before login and roam-restore fails.
# CONTROLLER_LAN_IP=192.168.88.2
