[Unit]
Description=MikroTik Controller Server
After=network.target

[Service]
Type=simple
User=mikrotik-controller
Group=mikrotik-controller
WorkingDirectory=/opt/mikrotik-controller
# NOTE: no chown here. ExecStartPre runs as the unprivileged 'mikrotik-controller'
# user, which cannot chown root-owned files (Operation not permitted), which would
# abort startup. Ownership is set as root by deploy/install.sh and deploy/update.sh.
ExecStart=/usr/bin/node /opt/mikrotik-controller/dist/server.js
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mikrotik-controller

Environment=NODE_ENV=production
Environment=PORT=3000
Environment=DB_PATH=/opt/mikrotik-controller/data/mikrotik-controller.db

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mikrotik-controller/data /opt/mikrotik-controller/hotspot

[Install]
WantedBy=multi-user.target
